.Content
{

}
.Top
{
  padding-top: 20rpx;
  box-shadow: 10rpx 10rpx 15rpx 10rpx #e1e1e1;
  background-color: rgb(13, 193, 238);
  border-radius: 20rpx;
}
.User_Info
{
  display: flex;
  width: 100%;
  height: 150rpx;
}
.User_Avatar
{
  margin: 0rpx 10rpx 10rpx 20rpx;
  align-self: center;
}
.User_Avatar image
{
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
}
.User_Tag
{
  display: flex;
  width: 500rpx;
  flex-direction: column;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  z-index: 9999;
}
.User_Name
{
  margin: auto;
  margin-left: 0;
  margin-bottom: 0;
}
.User_Name .User_Name_Text
{
  color: rgb(244, 243, 241);
  font-size: 34rpx;
  font-weight: 800;
}
.User_Flag
{
  margin: auto;
  margin-left: 0;
  margin-top: 0;
  display: block;
}
.RegisterTime
{
  background-color: darkorchid;
  color: gainsboro;
  padding: 5rpx 10rpx;
  font-size: 20rpx;
  border-radius: 8rpx;
}
.UserID
{
  background-color: cornflowerblue;
  color: rgb(117, 238, 123);
  padding: 5rpx 10rpx;
  font-size: 20rpx;
  border-radius: 8rpx;
}
.Bottom
{
  margin-top: 50rpx;
}
.Bottom_Content
{
  width: 95%; 
  border-radius: 5%;
  margin: auto;
  background-color: rgb(253, 253, 253);
  padding-bottom: 10rpx;
  box-shadow: 5rpx 5rpx 10rpx 5rpx #e1e1e1;
}
.Me_About
{
  display: flex;
  margin: 20rpx 40rpx;
  padding: 30rpx 0rpx;
  justify-content: space-between;
  border-bottom: 2rpx solid rgb(238, 238, 238);
}
.Me_About .Me_About_Image{
  align-self: center;
  width: 35rpx;
  height: 35rpx;
}