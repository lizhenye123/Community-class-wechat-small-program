}

.Publicity{
  width: 100%; 
  background: #d3d3d3; 
  height: 280rpx;
}
.Publicity .Swiper{
  width: 100%; 
  height: 280rpx;
}
.Publicity .Swiper_Item{
  width: 100%; 
  height: 100%;
}
.Swiper_Item_button{
  width: 100%;
  height: 100%;
}

.Module
{
  width: 90%;
  height: 150rpx;
  margin: auto;
  margin-top: 30rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  align-content: center;
  white-space: nowrap;
}
.Module .Module_Item
{
  display: inline-block;
  width: 94rpx;
  font-size: 20rpx;
  text-align: center;
  color: #aaa;
  margin: 34rpx 34rpx 0rpx 20rpx;
}
.Module .Module_Item .Module_Item_Image
{
  width: 84rpx;
  height: 84rpx;
}
.Module .Module_Item .Module_Item_Text
{
  display: block;
  font-size: 28rpx;
  text-align: center;
}
.Module .Module_Item .Module_Item_Button{}

.Sort_Content
{
  justify-content: center;
  margin: auto;
}
.Mess_sort
{
  width: 100%;
  background-color: rgb(251, 251, 251);
  border-radius: 11%;
}
.Leave_Message
{
  width: 85%;
  height: 100rpx;
  align-items: center;
}
.Message_image
{
  width: 60rpx;
  height: 60rpx;
}
.Message_Name
{
  padding: 0 4px;
  color: rgb(34, 173, 207);
  font-weight: 400;
  font-size: 27rpx;
  border: rgb(34, 173, 207) 1px solid;
  border-radius: 10rpx;
}