
.Content
{
  margin-top: 20rpx;
}
.Content_Input
{
  background-color: #ffffff;
  margin-bottom: 0rpx;
  position: relative;
  padding: 18rpx 24rpx;
}
.Text_Input 
{
  height: 250rpx;
  width: 100%;
  min-height: 250rpx;
  max-height: 400rpx;
  z-index: 998;
  margin: 0rpx 8rpx;
}

/* 视频以及图片展示 */
.Image_List
{
    display: flex;
    flex-wrap: wrap;
}
.Show_Image
{
  width: 28vw;
  height: 28vw;
  margin: 6rpx 10rpx 10rpx 10rpx;
}
.showImage image
{
  width: 100%;
  height: 100%;
}
.AddImage
{
  background: #f8f8f8;
  width: 28vw;
  height: 28vw;
  margin: 6rpx;
  display: flex;
  justify-content: center;
  align-items: center;
}
.AddImage image
{
  width: 40%;
  height: 40%;
}
.Video 
{
  width: 60vw;
  height: 60vw;
}
.Video video 
{
  width: 100%;
  height: 100%;
  z-index: 999;
}
.Box
{
  box-sizing: border-box;
  position: relative;
}
.Delete
{
  position:absolute;
  top: -21rpx;
  right: -21rpx;
  width: 42rpx;
  height: 42rpx;
  border-radius: 50%;
  background: rgba(0, 0, 0, .3);
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
}
.Delete image
{
  width: 32rpx;
  height: 32rpx;
}
 
/* 上传 */
.ToUpload
{
  display: flex;
  align-items: center;
}
.UploadIcon
{
  margin: 0px 10rpx 0rpx 0rpx;
  padding: 0px;
}
.UploadIcon image
{
  vertical-align: middle;
  width: 56rpx;
  height: 56rpx;
  padding: 8rpx 8rpx;
}
.UploadIcon:hover
{
  background-color: rgb(248, 248, 248);
}

.Tag_Title 
{
  font-size: 32rpx;
  margin: 0rpx 8rpx;
}
.Tag_List 
{
  margin-left: -14rpx; 
  display: flex;
  white-space: nowrap;
  justify-content: space-between;
  height: 80rpx;
  margin-top: 6rpx;
}
.Tag 
{
  border: 1px solid lightgray;
  border-radius: 2px;
  font-size: 28rpx;
  color: gray;
  padding: 6rpx 16rpx;
  margin: 10rpx 20rpx 10rpx 20rpx;
  word-break: keep-all;
}
.Arrow_Right 
{
  margin-left: auto;
  width: 48rpx; 
  height: 48rpx;
  min-width: 48rpx;
  max-width: 48rpx;
}
.ModuleSelect
{
  padding-left: 30rpx;
  padding-right: 30rpx;
  padding-top: 10rpx;
}
.PublishButton
{
  line-height: 80rpx;
  text-align: center;
}
.PublishButtonText
{
  text-align: center;
}