.Comment_Item {
  margin: 20rpx 0 20rpx 24rpx;
  padding: 24rpx 24rpx 24rpx 0;
  border-bottom: 1rpx solid #f2e7e1;
}
.Comment_Item_Header {
  display: flex;
  flex-direction: row;
  align-items: center;
}
.Comment_Item_Header .Left_Img image {
  height: 90rpx;
  width: 90rpx;
  border-radius: 50%;
}
.Comment_Item_Header .Right_User {
  margin-left: 30rpx;
  line-height: 80rpx;
}
.Comment_Item_Header .Right_User text {
  font-size: 30rpx;
  flex-direction: row;
  color: #212121;
}
.Comment_Body {
  font-size: 26rpx;
  line-height: 26rpx;
  color: #666;
  padding: 10rpx 0;
}
.Comment_Txt text {
  line-height: 50rpx;
}
.Comment_Img {
  margin: 10rpx 0;
}
.Comment_Img .Comment_Img_Image {
  max-width: 32%;
  margin-right: 10rpx;
  height: 220rpx;
  width: 220rpx;
}
.Comment_Time {
  margin-top: 10rpx;
  color: #ccc;
  font-size: 24rpx;
}